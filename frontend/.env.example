# Surge — Firebase Configuration
# Copy this file to `.env` and fill in values from your Firebase console
# (Firebase Console → Project Settings → Web App → SDK setup).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Auth Setup:
# 1. Enable Google Sign-In: Authentication → Sign-in method → Add Provider → Google.
# 2. Enable Google Authenticator 2FA: Authentication → Settings → Multi-factor authentication → Enable TOTP.

