# Surge Environment Configuration
# Copy this file to `.env` and fill in your secure production credentials.

# Security & Secrets (generate a 64-char key using: openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_random_64_character_hex_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment Mode: 'development' or 'production'
ENVIRONMENT=development

# Allowed Origins for CORS (comma-separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (Async SQLAlchemy)
# Dev (SQLite): sqlite+aiosqlite:///backend/surge.db
# Prod (PostgreSQL): postgresql+asyncpg://surge_user:secure_password@localhost:5432/surge
DATABASE_URL=sqlite+aiosqlite:///backend/surge.db

# Redis Event Broker & Alert Queue
REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# External Emergency Dispatch (Slack / Discord / Custom Webhook / Telegram)
# DISPATCH_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890
